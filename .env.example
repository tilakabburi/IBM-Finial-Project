# Server configuration
PORT=3000
NODE_ENV=development

# IBM Cloud credentials (replace these placeholders locally; never commit real values)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
WML_SCORING_URL=https://your-region.ml.cloud.ibm.com/ml/v4/deployments/your-deployment-id/predictions?version=2021-05-01

# Optional Flask application variables
IBM_MODEL_URL=https://your-model-endpoint.example.com
IBM_API_KEY=your_ibm_api_key_here
IBM_TOKEN=your_ibm_token_here
